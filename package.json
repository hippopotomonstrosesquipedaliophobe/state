{
  "name": "@vvi/state",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "b": "rollup --config rollup.config.js && tsc -p tsconfig.types.json",
    "build": "jja cls rm dist && pnpm run b && pnpm run clean:package",
    "clean:package": "node scripts/clean-package-json.js",
    "diff": "jja pkg --diff",
    "prepublishOnly": "pjj",
    "push": "gvv",
    "push:version": "gvv",
    "test": "jja rm .eg && rollup --config rollup.config.eg.js && node .eg/index.js",
    "vjj": "vjj",
    "lint": "jja cls && eslint . --fix",
    "beautify": "jja cls && prettier . --write"
  },
  "jja": {
    "pkg": [
      "eslint",
      "typescript"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@vvi/check-version": "^2.0.0",
    "@vvi/node": "^6.0.0",
    "@vvi/rollup-external": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.4.10",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "gvv": "^2.0.0",
    "jja": "^3.0.0",
    "pjj": "^2.0.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.5",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vjj": "^2.0.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}